{
  "name": "the-bread-club",
  "version": "1.0.0",
  "private": true,
  "description": "The Bread Club website and order page",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=site/assets/js/logic.js --test-coverage-include=apps-script/src/server.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/unit/*.test.js",
    "integration": "node --test tests/integration/*.test.js",
    "e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "lint": "eslint .",
    "build:apps-script": "node tools/build-apps-script.js",
    "check": "npm run lint && npm run coverage && npm run build:apps-script && npm run integration && npm run e2e",
    "dev": "node tools/dev-server.js"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0"
  }
}
