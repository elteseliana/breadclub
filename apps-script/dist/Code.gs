// The Bread Club order backend. GENERATED by `npm run build:apps-script`, do not edit by hand.
// Paste this whole file into Code.gs in the Apps Script editor. Source: site/assets/js/logic.js, apps-script/src/server.js, apps-script/src/Code.js

// ---- site/assets/js/logic.js ----
/*
 * The Bread Club: order rules shared by the website and the Google Apps Script backend.
 *
 * Everything that decides money, dates or capacity lives here so that the browser
 * (for showing totals) and the server (for accepting orders) use the same rules.
 * The server always recalculates; it never trusts a total sent by the browser.
 */
var BreadClub = (function () {
  'use strict';

  // ---- Business rules (approved by Eliana, Nov 2026) ----------------------

  var MENU = [
    { id: 'plain', section: 'original', price: 35, name: { en: 'Plain sourdough', he: 'מחמצת קלאסית' } },
    { id: 'garlic', section: 'collection', price: 42, name: { en: 'Garlic', he: 'שום' } },
    { id: 'rosemary-garlic', section: 'collection', price: 44, name: { en: 'Rosemary garlic', he: 'שום ורוזמרין' } },
    { id: 'cinnamon-sugar', section: 'collection', price: 42, name: { en: 'Cinnamon sugar', he: 'קינמון וסוכר' } },
    { id: 'olive', section: 'collection', price: 44, name: { en: 'Olive', he: 'זיתים' } },
    { id: 'chocolate-chip', section: 'collection', price: 44, name: { en: 'Chocolate chip', he: 'שוקולד צ׳יפס' } },
    { id: 'pesto', section: 'collection', price: 50, name: { en: 'Pesto', he: 'פסטו' } }
  ];

  var RULES = {
    timeZone: 'Asia/Jerusalem',
    deliveryWeekdays: [2, 5], // Tuesday, Friday (0 = Sunday)
    cutoffDaysBefore: 2, // Tuesday -> Sunday, Friday -> Wednesday
    cutoffHour: 16, // 4pm Israel time
    deliveryFee: 5,
    freeDeliveryFrom: 100, // subtotal of 100 or more delivers free
    defaultCapacity: 18, // loaves per bake day
    datesShown: 2, // how many upcoming bake days the order page offers
    searchDays: 60, // how far ahead to look when many days are closed
    maxQtyPerItem: 99,
    maxName: 80,
    maxAddress: 200,
    maxNotes: 500
  };

  // No prototype, so names like "constructor" or "toString" are never menu items.
  var MENU_BY_ID = Object.create(null);
  MENU.forEach(function (item) { MENU_BY_ID[item.id] = item; });

  // ---- Dates (all calendar dates are 'YYYY-MM-DD' strings in Israel time) --


  /** Current Israel date and minutes since midnight for a given instant. */
  function israelNow(instant) {
    var parts = {};
    new Intl.DateTimeFormat('en-GB', {
      timeZone: RULES.timeZone, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
    }).formatToParts(instant).forEach(function (p) { parts[p.type] = p.value; });
    return {
      date: parts.year + '-' + parts.month + '-' + parts.day,
      minutes: Number(parts.hour) * 60 + Number(parts.minute)
    };
  }

  function isIsoDate(s) {
    if (typeof s !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
    var d = new Date(s + 'T00:00:00Z');
    return !isNaN(d.getTime()) && d.toISOString().slice(0, 10) === s;
  }

  function addDays(iso, n) {
    var d = new Date(iso + 'T00:00:00Z');
    d.setUTCDate(d.getUTCDate() + n);
    return d.toISOString().slice(0, 10);
  }

  function weekday(iso) { return new Date(iso + 'T00:00:00Z').getUTCDay(); }

  function cutoffFor(deliveryDate) {
    return { date: addDays(deliveryDate, -RULES.cutoffDaysBefore), hour: RULES.cutoffHour };
  }

  function isDeliveryDay(iso) { return RULES.deliveryWeekdays.indexOf(weekday(iso)) !== -1; }

  /** True while orders for this delivery date are still accepted. */
  function isOrderable(deliveryDate, now) {
    var cutoff = cutoffFor(deliveryDate);
    if (now.date !== cutoff.date) return now.date < cutoff.date;
    return now.minutes < cutoff.hour * 60;
  }

  /** The next bake days customers can order for, skipping closed dates. */
  function upcomingDates(now, closedDates, count) {
    var closed = closedDates || [];
    var want = count || RULES.datesShown;
    var out = [];
    for (var i = 0; i <= RULES.searchDays && out.length < want; i++) {
      var d = addDays(now.date, i);
      if (isDeliveryDay(d) && closed.indexOf(d) === -1 && isOrderable(d, now)) out.push(d);
    }
    return out;
  }

  // ---- Money ---------------------------------------------------------------

  /** Price an order. items: { menuId: quantity }. Unknown ids and zero quantities are ignored. */
  function quote(items, method) {
    var lines = [];
    var loaves = 0;
    var subtotal = 0;
    MENU.forEach(function (item) {
      var qty = (items && items[item.id]) || 0;
      if (qty > 0) {
        lines.push({ id: item.id, qty: qty, price: item.price, lineTotal: qty * item.price });
        loaves += qty;
        subtotal += qty * item.price;
      }
    });
    var deliveryFee = method === 'delivery' && subtotal < RULES.freeDeliveryFrom ? RULES.deliveryFee : 0;
    return { lines: lines, loaves: loaves, subtotal: subtotal, deliveryFee: deliveryFee, total: subtotal + deliveryFee };
  }

  // ---- Contact details -------------------------------------------------------

  /** Israeli mobile number as 05XXXXXXXX, or null. Accepts spaces, dashes, +972 / 972 prefixes. */
  function normalizePhone(raw) {
    if (typeof raw !== 'string') return null;
    var digits = raw.replace(/[\s\-().]/g, '');
    if (/^\+?972/.test(digits)) digits = '0' + digits.replace(/^\+?972/, '');
    return /^05\d{8}$/.test(digits) ? digits : null;
  }

  /** wa.me link for an Israeli mobile number (05XXXXXXXX), with optional prefilled text. */
  function whatsappLink(phone, text) {
    var url = 'https://wa.me/972' + phone.slice(1);
    return text ? url + '?text=' + encodeURIComponent(text) : url;
  }

  // ---- Validation ------------------------------------------------------------

  function cleanText(v) { return typeof v === 'string' ? v.replace(/\s+/g, ' ').trim() : ''; }

  /**
   * Check a submitted order. ctx = { now, closedDates }.
   * Returns { ok: true, order } or { ok: false, errors: { field: code } }.
   */
  function validateOrder(input, ctx) {
    var src = input && typeof input === 'object' ? input : {};
    var errors = {};

    var orderId = typeof src.orderId === 'string' ? src.orderId : '';
    if (!/^[A-Za-z0-9-]{8,64}$/.test(orderId)) errors.orderId = 'invalid';

    var name = cleanText(src.name);
    if (name.length < 2) errors.name = 'required';
    else if (name.length > RULES.maxName) errors.name = 'too_long';

    var phone = normalizePhone(src.phone);
    if (!phone) errors.phone = 'invalid';

    var items = {};
    var rawItems = src.items && typeof src.items === 'object' ? src.items : {};
    Object.keys(rawItems).forEach(function (id) {
      var qty = rawItems[id];
      if (!MENU_BY_ID[id] || typeof qty !== 'number' || qty % 1 !== 0 || qty < 0 || qty > RULES.maxQtyPerItem) {
        errors.items = 'invalid';
      } else if (qty > 0) {
        items[id] = qty;
      }
    });
    if (!errors.items && Object.keys(items).length === 0) errors.items = 'empty';

    var method = src.method;
    if (method !== 'pickup' && method !== 'delivery') errors.method = 'required';

    var address = cleanText(src.address);
    if (method === 'delivery') {
      if (address.length < 4) errors.address = 'required';
      else if (address.length > RULES.maxAddress) errors.address = 'too_long';
    } else {
      address = '';
    }

    var payment = src.payment;
    if (payment !== 'bit' && payment !== 'cash') errors.payment = 'required';

    var date = src.date;
    if (!isIsoDate(date) || upcomingDates(ctx.now, ctx.closedDates).indexOf(date) === -1) errors.date = 'closed';

    var notes = typeof src.notes === 'string' ? src.notes.trim() : '';
    if (notes.length > RULES.maxNotes) errors.notes = 'too_long';

    var lang = src.lang === 'he' ? 'he' : 'en';

    if (Object.keys(errors).length) return { ok: false, errors: errors };
    return {
      ok: true,
      order: {
        orderId: orderId, name: name, phone: phone, items: items, method: method,
        address: address, payment: payment, date: date, notes: notes, lang: lang
      }
    };
  }

  /** Whether `requested` more loaves fit on a day that already has `booked`. */
  function checkCapacity(booked, requested, capacity) {
    var remaining = Math.max(0, capacity - booked);
    return { ok: requested <= remaining, remaining: remaining };
  }

  var api = {
    MENU: MENU, RULES: RULES, israelNow: israelNow, isIsoDate: isIsoDate, addDays: addDays,
    weekday: weekday, cutoffFor: cutoffFor, isOrderable: isOrderable, upcomingDates: upcomingDates,
    quote: quote, normalizePhone: normalizePhone, whatsappLink: whatsappLink,
    validateOrder: validateOrder, checkCapacity: checkCapacity
  };
  return api;
})();

// Export for Node tests. Browsers and Apps Script use the global `BreadClub` instead.
/* node:coverage ignore next */
if (typeof module !== 'undefined') module.exports = BreadClub;

// ---- apps-script/src/server.js ----
/*
 * The Bread Club: order handling, independent of where orders are stored.
 *
 * `store` is a small interface so the same code runs against Google Sheets
 * (Code.js) and against an in-memory/file store in tests and local preview:
 *   store.getSettings()      -> { capacity: number, closedDates: ['YYYY-MM-DD'] }
 *   store.listOrders()       -> [{ orderId, orderNumber, date, phone, loaves, total, method, payment, status }]
 *   store.appendOrder(rec, reminderFor) -> orderNumber (number)
 *                            reminderFor(orderNumber) -> null (cash) or { phone, before, after }:
 *                            WhatsApp reminder text = before + current total + after
 * The caller must hold a lock around submit() so two orders cannot race for
 * the last loaves (Code.js uses LockService).
 */
var BreadClubServer = (function () {
  'use strict';

  var BIT_NUMBER = '054-911-2175';
  var DAY_NAMES = {
    en: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    he: ['ראשון', 'שני', 'שלישי', 'רביעי', 'חמישי', 'שישי', 'שבת']
  };

  function bookedLoaves(orders, date) {
    return orders.reduce(function (sum, o) {
      return o.date === date && o.status !== 'canceled' ? sum + o.loaves : sum;
    }, 0);
  }

  function shortDate(iso) {
    return Number(iso.slice(8, 10)) + '.' + Number(iso.slice(5, 7));
  }

  /**
   * Pre-written Bit payment reminder, opened in WhatsApp by Eliana or Shayna (they press send).
   * Returned in two parts around the total, so the sheet can rebuild it if the total is edited.
   */
  function reminderParts(logic, order, orderNumber) {
    var day = DAY_NAMES[order.lang][logic.weekday(order.date)];
    if (order.lang === 'he') {
      return {
        before: 'היי ' + order.name + ', כאן The Bread Club. תזכורת קטנה: ההזמנה שלך (#' + orderNumber +
          ') ליום ' + day + ' ' + shortDate(order.date) + ' יוצאת ₪',
        after: '. אפשר לשלם בביט ל-' + BIT_NUMBER + ' (עם השם המלא בהערה). תודה'
      };
    }
    return {
      before: 'Hi ' + order.name + ', this is The Bread Club. A quick reminder that your order (#' + orderNumber +
        ') for ' + day + ' ' + shortDate(order.date) + ' comes to ₪',
      after: '. You can pay by Bit to ' + BIT_NUMBER + ' (please write your full name in the note). Thank you'
    };
  }

  function reminderText(logic, order, total, orderNumber) {
    var parts = reminderParts(logic, order, orderNumber);
    return parts.before + total + parts.after;
  }

  function receipt(orderNumber, orderId, date, q, extra) {
    var r = {
      ok: true, orderNumber: orderNumber, orderId: orderId, date: date,
      loaves: q.loaves, subtotal: q.subtotal, deliveryFee: q.deliveryFee, total: q.total
    };
    Object.keys(extra).forEach(function (k) { r[k] = extra[k]; });
    return r;
  }

  function createHandler(deps) {
    var logic = deps.logic;
    var store = deps.store;
    var clock = deps.now;

    function availability() {
      try {
        var settings = store.getSettings();
        var orders = store.listOrders();
        var now = logic.israelNow(clock());
        var dates = logic.upcomingDates(now, settings.closedDates).map(function (date) {
          var remaining = Math.max(0, settings.capacity - bookedLoaves(orders, date));
          return { date: date, cutoff: logic.cutoffFor(date), remaining: remaining, soldOut: remaining === 0 };
        });
        return { ok: true, dates: dates };
      } catch (e) {
        return { ok: false, error: 'server' };
      }
    }

    function submit(payload) {
      try {
        var input = payload && typeof payload === 'object' ? payload : {};

        // Bots fill the hidden "website" field. Store nothing, and never claim success: a real
        // customer whose browser autofilled it sees "couldn't confirm" plus the WhatsApp option.
        if (input.website) return { ok: false, error: 'server' };

        var orders = store.listOrders();

        // Same orderId again (double tap, retry after a timeout): return the original order.
        // (Rows typed into the sheet by hand have no orderId, so only look up real ids.)
        var id = typeof input.orderId === 'string' && input.orderId.length >= 8 ? input.orderId : null;
        var existing = id && orders.filter(function (o) { return o.orderId === id; })[0];
        if (existing) {
          return { ok: true, duplicate: true, orderNumber: existing.orderNumber, orderId: existing.orderId,
            date: existing.date, loaves: existing.loaves, total: existing.total,
            method: existing.method, payment: existing.payment };
        }

        var settings = store.getSettings();
        var now = logic.israelNow(clock());
        var checked = logic.validateOrder(input, { now: now, closedDates: settings.closedDates });
        if (!checked.ok) return { ok: false, error: 'invalid', fields: checked.errors };
        var order = checked.order;

        var q = logic.quote(order.items, order.method);
        var cap = logic.checkCapacity(bookedLoaves(orders, order.date), q.loaves, settings.capacity);
        if (!cap.ok) return { ok: false, error: 'full', date: order.date, remaining: cap.remaining };

        var record = {
          orderId: order.orderId, receivedAt: clock().toISOString(), date: order.date,
          weekday: logic.weekday(order.date), name: order.name, phone: order.phone,
          method: order.method, address: order.address, payment: order.payment,
          items: order.items, loaves: q.loaves, subtotal: q.subtotal, deliveryFee: q.deliveryFee,
          total: q.total, notes: order.notes, lang: order.lang, status: 'new', paid: false
        };
        var orderNumber = store.appendOrder(record, function (n) {
          // Cash is paid at the door, so cash orders get no payment reminder.
          if (order.payment !== 'bit') return null;
          var parts = reminderParts(logic, order, n);
          return { phone: order.phone, before: parts.before, after: parts.after };
        });
        return receipt(orderNumber, order.orderId, order.date, q, { method: order.method, payment: order.payment });
      } catch (e) {
        return { ok: false, error: 'server' };
      }
    }

    return { availability: availability, submit: submit };
  }

  return { createHandler: createHandler, reminderParts: reminderParts, reminderText: reminderText, bookedLoaves: bookedLoaves };
})();

/* node:coverage ignore next */
if (typeof module !== 'undefined') module.exports = BreadClubServer;

// ---- apps-script/src/Code.js ----
/*
 * The Bread Club: Google Sheets adapter (runs only inside Google Apps Script).
 *
 * This is the thin layer between the order rules (logic.js, server.js) and the
 * spreadsheet. It is not run by the automated unit tests because it needs Google's
 * SpreadsheetApp; the same handler is exercised end to end with a file store.
 * Setup steps are in the owners' private guide (Sheet setup).
 */

var SHEETS = {
  orders: 'Website orders',
  test: 'Test orders',
  summary: 'Bake summary',
  settings: 'Settings'
};

var STATUS = ['new', 'delivered', 'canceled'];
var FIRST_ORDER_NUMBER = 1001;

var COLUMNS = (function () {
  var cols = ['Order #', 'Received', 'Delivery date', 'Day', 'Name', 'Phone', 'Pickup / delivery', 'Address', 'Pays by'];
  BreadClub.MENU.forEach(function (item) { cols.push(item.name.en); });
  return cols.concat(['Loaves', 'Subtotal ₪', 'Delivery ₪', 'Total ₪', 'Notes', 'Language', 'Paid',
    'Status', 'Payment reminder', 'Order ID']);
})();

function col(name) { return COLUMNS.indexOf(name); } // 0-based
function colLetter(name) {
  var n = col(name) + 1;
  var s = '';
  while (n > 0) { var m = (n - 1) % 26; s = String.fromCharCode(65 + m) + s; n = Math.floor((n - 1) / 26); }
  return s;
}

function toIsoDate(v) {
  if (Object.prototype.toString.call(v) === '[object Date]') return Utilities.formatDate(v, BreadClub.RULES.timeZone, 'yyyy-MM-dd');
  return String(v || '').trim().replace(/^'/, '');
}

// ---- Store backed by the spreadsheet ---------------------------------------

/**
 * Text typed by customers must never become a formula. Sheets treats a value starting with
 * = + - @ as a formula (e.g. =IMPORTXML(...) could leak the sheet), so force it to plain text.
 */
function safeText(v) {
  var s = String(v === undefined || v === null ? '' : v);
  return /^[=+\-@\t\r\n]/.test(s) ? "'" + s : s;
}

function quoteFormulaString(s) { return '"' + String(s).replace(/"/g, '""') + '"'; }

/** Spreadsheet formulas for one row, so totals follow any quantity Eliana edits by hand. */
function rowFormulas(r) {
  var first = colLetter(BreadClub.MENU[0].name.en);
  var lastItem = colLetter(BreadClub.MENU[BreadClub.MENU.length - 1].name.en);
  var subtotal = BreadClub.MENU.map(function (item) { return 'N(' + colLetter(item.name.en) + r + ')*' + item.price; }).join('+');
  var sub = colLetter('Subtotal ₪') + r;
  return {
    loaves: '=SUM(' + first + r + ':' + lastItem + r + ')',
    subtotal: '=' + subtotal,
    delivery: '=IF(AND(' + colLetter('Pickup / delivery') + r + '="Delivery",' + sub + '<' +
      BreadClub.RULES.freeDeliveryFrom + '),' + BreadClub.RULES.deliveryFee + ',0)',
    total: '=' + sub + '+' + colLetter('Delivery ₪') + r
  };
}

/** WhatsApp reminder that always uses the row's current total, and disappears once Paid is ticked. */
function reminderFormula(r, reminder) {
  var url = 'https://wa.me/972' + reminder.phone.slice(1) + '?text=';
  return '=IF(' + colLetter('Paid') + r + '=TRUE,"",HYPERLINK(' + quoteFormulaString(url) + '&ENCODEURL(' +
    quoteFormulaString(reminder.before) + '&' + colLetter('Total ₪') + r + '&' + quoteFormulaString(reminder.after) +
    '),"Send reminder"))';
}

function sheetStore(test) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(test ? SHEETS.test : SHEETS.orders);
  if (!sheet) throw new Error('Run setup() first: missing sheet');

  return {
    getSettings: function () {
      var s = ss.getSheetByName(SHEETS.settings);
      var raw = s.getRange('B2').getValue();
      var capacity = Number(raw);
      if (raw === '' || raw === null || !(capacity >= 0) || capacity % 1 !== 0) capacity = BreadClub.RULES.defaultCapacity;
      var last = s.getLastRow();
      var closed = last >= 6 ? s.getRange(6, 1, last - 5, 1).getValues()
        .map(function (r) { return toIsoDate(r[0]); })
        .filter(BreadClub.isIsoDate) : [];
      return { capacity: capacity, closedDates: closed };
    },

    listOrders: function () {
      var last = sheet.getLastRow();
      if (last < 2) return [];
      return sheet.getRange(2, 1, last - 1, COLUMNS.length).getValues().map(function (r) {
        // Count loaves from the flavor columns, so editing a quantity updates the day's count.
        var items = {};
        var counted = 0;
        BreadClub.MENU.forEach(function (item) {
          var q = Number(r[col(item.name.en)]) || 0;
          if (q > 0) { items[item.id] = q; counted += q; }
        });
        var method = r[col('Pickup / delivery')] === 'Delivery' ? 'delivery' : 'pickup';
        var digits = String(r[col('Phone')] || '').replace(/\D/g, '');
        if (digits.length === 9) digits = '0' + digits; // a hand-typed number that lost its leading 0
        return {
          orderNumber: r[col('Order #')],
          orderId: String(r[col('Order ID')] || ''),
          date: toIsoDate(r[col('Delivery date')]),
          phone: digits,
          // A hand-typed row may only fill in "Loaves".
          loaves: counted || Number(r[col('Loaves')]) || 0,
          total: counted ? BreadClub.quote(items, method).total : Number(r[col('Total ₪')]) || 0,
          method: method,
          payment: /^cash/i.test(String(r[col('Pays by')])) ? 'cash' : 'bit',
          status: String(r[col('Status')] || '').trim().toLowerCase()
        };
      });
    },

    appendOrder: function (rec, reminderFor) {
      var last = sheet.getLastRow();
      var numbers = last >= 2 ? sheet.getRange(2, 1, last - 1, 1).getValues()
        .map(function (r) { return Number(r[0]) || 0; }) : [];
      var orderNumber = Math.max.apply(null, [FIRST_ORDER_NUMBER - 1].concat(numbers)) + 1;
      var rowIndex = last + 1;
      if (rowIndex > sheet.getMaxRows()) {
        // A new sheet has 1,000 rows; add more (with the same formats) when they run out.
        sheet.insertRowsAfter(sheet.getMaxRows(), 500);
        formatOrderRows(sheet);
      }
      var f = rowFormulas(rowIndex);
      var reminder = reminderFor(orderNumber);

      var row = [
        orderNumber,
        Utilities.formatDate(new Date(rec.receivedAt), BreadClub.RULES.timeZone, 'yyyy-MM-dd HH:mm'),
        rec.date, // column is plain-text format (set in setup), so it stays text
        ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][rec.weekday],
        safeText(rec.name),
        rec.phone, // plain-text column keeps the leading 0
        rec.method === 'delivery' ? 'Delivery' : 'Pickup',
        safeText(rec.address),
        rec.payment === 'bit' ? 'Bit' : 'Cash at door'
      ];
      BreadClub.MENU.forEach(function (item) { row.push(rec.items[item.id] || ''); });
      row.push(f.loaves, f.subtotal, f.delivery, f.total, safeText(rec.notes),
        rec.lang === 'he' ? 'Hebrew' : 'English', false, rec.status,
        reminder ? reminderFormula(rowIndex, reminder) : '', safeText(rec.orderId));

      sheet.getRange(rowIndex, 1, 1, row.length).setValues([row]);
      sheet.getRange(rowIndex, col('Paid') + 1).insertCheckboxes();
      SpreadsheetApp.flush();
      return orderNumber;
    }
  };
}

function handlerFor(test) {
  return BreadClubServer.createHandler({
    logic: BreadClub,
    store: sheetStore(test),
    now: function () { return new Date(); }
  });
}

function json(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

// ---- Web app entry points ----------------------------------------------------

function doGet(e) {
  var p = (e && e.parameter) || {};
  if (p.action !== 'availability') return json({ ok: true, service: 'the-bread-club-orders' });
  try {
    return json(handlerFor(p.test === '1').availability());
  } catch (err) {
    return json({ ok: false, error: 'server' });
  }
}

function doPost(e) {
  var payload;
  try {
    payload = JSON.parse(e.postData.contents);
  } catch (err) {
    return json({ ok: false, error: 'bad_request' });
  }
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return json({ ok: false, error: 'busy' });
  try {
    return json(handlerFor(payload && payload.test === true).submit(payload));
  } catch (err) {
    return json({ ok: false, error: 'server' });
  } finally {
    lock.releaseLock();
  }
}

// ---- One-time setup: run this from the Apps Script editor --------------------

function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  setupOrdersSheet(ss, SHEETS.orders);
  setupOrdersSheet(ss, SHEETS.test);
  setupSettings(ss);
  setupSummary(ss);
}

function getOrCreate(ss, name) { return ss.getSheetByName(name) || ss.insertSheet(name); }

function setupOrdersSheet(ss, name) {
  var sheet = getOrCreate(ss, name);
  sheet.getRange(1, 1, 1, COLUMNS.length).setValues([COLUMNS]).setFontWeight('bold').setBackground('#E6D8C2');
  sheet.setFrozenRows(1);
  sheet.setFrozenColumns(1);

  formatOrderRows(sheet);
}

/** Formats, checkboxes, dropdowns and highlighting for every data row (safe to run again). */
function formatOrderRows(sheet) {
  var rows = sheet.getMaxRows() - 1;
  sheet.getRange(2, col('Pays by') + 1, rows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(['Bit', 'Cash at door'], true).build());
  // Plain text, so a date typed by hand (2026-11-10) stays text like the website's and is summed.
  sheet.getRange(2, col('Delivery date') + 1, rows, 1).setNumberFormat('@');
  sheet.getRange(2, col('Phone') + 1, rows, 1).setNumberFormat('@');
  sheet.getRange(2, col('Paid') + 1, rows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireCheckbox().build());
  sheet.getRange(2, col('Status') + 1, rows, 1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(STATUS, true).setAllowInvalid(false).build());

  // Highlight: unpaid Bit orders (not canceled) in soft tan; canceled rows greyed out.
  // Cash orders are not flagged: they pay at the door.
  var all = sheet.getRange(2, 1, rows, COLUMNS.length);
  var paid = '$' + colLetter('Paid') + '2';
  var status = '$' + colLetter('Status') + '2';
  var first = '$A2';
  var pays = '$' + colLetter('Pays by') + '2';
  sheet.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=AND(' + first + '<>"",' + status + '="canceled")')
      .setFontColor('#9C8B77').setStrikethrough(true).setRanges([all]).build(),
    SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=AND(' + first + '<>"",' + pays + '="Bit",' + paid + '<>TRUE,' + status + '<>"canceled")')
      .setBackground('#F4E1CF').setRanges([all]).build()
  ]);
}

function setupSettings(ss) {
  var s = getOrCreate(ss, SHEETS.settings);
  if (s.getRange('A1').getValue() === '') {
    s.getRange('A1:B2').setValues([['Setting', 'Value'], ['Loaves per bake day', BreadClub.RULES.defaultCapacity]]);
    s.getRange('A4').setValue('Closed days (no orders). One date per row, e.g. 2026-12-25:');
    s.getRange('A1:B1').setFontWeight('bold');
    s.getRange('A4').setFontWeight('bold');
    s.getRange('A6:A100').setNumberFormat('yyyy-mm-dd');
    s.setColumnWidth(1, 420);
  }
}

function setupSummary(ss) {
  var s = getOrCreate(ss, SHEETS.summary);
  s.clear();
  var range = "'" + SHEETS.orders + "'!A2:" + colLetter('Order ID');
  var d = colLetter('Delivery date');
  var st = colLetter('Status');
  var sums = BreadClub.MENU.map(function (item) { return 'sum(' + colLetter(item.name.en) + ')'; });
  sums.push('sum(' + colLetter('Loaves') + ')');
  var labels = BreadClub.MENU.map(function (item) {
    return 'sum(' + colLetter(item.name.en) + ") '" + item.name.en + "'";
  });
  labels.push('sum(' + colLetter('Loaves') + ") 'Total loaves'");

  s.getRange('A1').setValue('What to bake (canceled orders not counted)').setFontWeight('bold');
  s.getRange('A2').setFormula('=QUERY(' + range + ', "select ' + d + ', ' + sums.join(', ') +
    ' where ' + d + " is not null and " + st + " <> 'canceled' group by " + d + ' order by ' + d +
    ' desc label ' + d + " 'Delivery date', " + labels.join(', ') + '", 0)');

  s.getRange('L1').setValue('Bit orders still unpaid').setFontWeight('bold');
  var pays = colLetter('Pays by');
  var paid = colLetter('Paid');
  var total = colLetter('Total ₪');
  s.getRange('L2').setFormula('=QUERY(' + range + ', "select ' + d + ', count(A), sum(' + total + ')' +
    ' where ' + d + ' is not null and ' + pays + " = 'Bit' and not " + paid + ' = true and ' + st +
    " <> 'canceled' group by " + d +
    ' order by ' + d + ' desc label ' + d + " 'Delivery date', count(A) 'Unpaid orders', sum(" + total +
    ") 'Unpaid ₪'\", 0)");
}
